{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test --timeout 60000",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test --timeout 30000 test/integration",
    "test:concurrency": "bun test --timeout 60000 test/concurrency",
    "infra:up": "docker compose up -d --wait postgres sqs",
    "infra:down": "docker compose down",
    "sqs:setup": "bun src/infrastructure/sqs/setup-queues.ts",
    "db:migrate": "bun src/infrastructure/persistence/migrate.ts up",
    "db:rollback": "bun src/infrastructure/persistence/migrate.ts down",
    "db:pending": "bun src/infrastructure/persistence/migrate.ts pending"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1172.0",
    "@mikro-orm/core": "7.2.10",
    "@mikro-orm/migrations": "7.2.10",
    "@mikro-orm/postgresql": "7.2.10",
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.4",
    "@types/express": "5.0.6",
    "typescript": "7.0.2"
  }
}
