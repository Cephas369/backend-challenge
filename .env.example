# Copie para .env para rodar `bun run dev` contra a infraestrutura do compose (`bun run infra:up`).
# O Bun carrega .env automaticamente. Valores locais, sem segredos reais.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://wagering:wagering@127.0.0.1:55432/wagering
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=2000
DATABASE_LOCK_TIMEOUT_MS=2000
DATABASE_STATEMENT_TIMEOUT_MS=5000

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://127.0.0.1:4566
SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wagering-events.fifo
SQS_MAX_RECEIVE_COUNT=5
SQS_VISIBILITY_TIMEOUT_SECONDS=30

HEALTH_CHECK_TIMEOUT_MS=1000

# Papéis desta instância (a mesma imagem roda qualquer combinação); health fica sempre no ar
APP_ROLES=api,consumer,outbox,pending-ref
SHUTDOWN_GRACE_MS=20000

# Consumer de wager-transactions.fifo
CONSUMER_NAME=wagering-processor
SQS_WAIT_TIME_SECONDS=20
SQS_RECEIVE_BATCH_SIZE=10
SQS_RETRY_BASE_DELAY_SECONDS=2

# Publisher da outbox
OUTBOX_BATCH_SIZE=10
OUTBOX_IDLE_DELAY_MS=500
OUTBOX_SEND_TIMEOUT_MS=3000

# Worker de referências pendentes
PENDING_REFERENCE_BATCH_SIZE=20
PENDING_REFERENCE_IDLE_DELAY_MS=1000
PENDING_REFERENCE_LEASE_MS=30000
REFERENCE_RETRY_INITIAL_DELAY_MS=1000
REFERENCE_RETRY_MAX_DELAY_MS=60000
REFERENCE_TTL_MS=900000
